@Library('Shared') _

pipeline {

    agent {
        label 'shakthiAgent'
    }

    environment {

        // ========================================================
        // APPLICATION
        // ========================================================

        APP_NAME = 'sparkNote'
        APP_VERSION = "1.0.${BUILD_NUMBER}"


        // ========================================================
        // DIRECTORIES
        // ========================================================

        FRONTEND_DIR = 'frontend'
        BACKEND_DIR = 'BlogApplication'


        // ========================================================
        // DOCKER
        // ========================================================

        DOCKER_USERNAME = 'shakthivelk24'

        FRONTEND_IMAGE = "${DOCKER_USERNAME}/sparknote-frontend"
        BACKEND_IMAGE = "${DOCKER_USERNAME}/sparknote-backend"

        IMAGE_TAG = "${BUILD_NUMBER}"


        // ========================================================
        // SONARQUBE
        // ========================================================

        SONAR_PROJECT_KEY = 'sparkNote'


        // ========================================================
        // TRIVY
        // ========================================================

        TRIVY_REPORT_DIR = 'reports/trivy'
    }


    // ============================================================
    // OPTIONS
    // ============================================================

    options {

        timestamps()

        ansiColor('xterm')

        timeout(
            time: 60,
            unit: 'MINUTES'
        )

        buildDiscarder(
            logRotator(
                numToKeepStr: '10'
            )
        )

        disableConcurrentBuilds()
    }


    // ============================================================
    // STAGES
    // ============================================================

    stages {


        // ========================================================
        // 1. CHECK TOOLS
        // ========================================================

        stage('🔧 Check Tools') {

            steps {

                cleanWs()

                customLog(
                    'Checking required tools...'
                )

                check()
            }
        }


        // ========================================================
        // 2. CHECKOUT
        // ========================================================

        stage('🔄 Checkout') {

            steps {

                customLog(
                    'Checking out source code...'
                )

                checkout scm

                bat '''
                    echo ========================================
                    echo Git Information
                    echo ========================================

                    git log --oneline -5

                    echo.

                    git status
                '''
            }
        }


        // ========================================================
        // 3. INSTALL DEPENDENCIES
        // ========================================================

        stage('📦 Install Dependencies') {

            parallel {

                stage('Frontend Dependencies') {

                    steps {

                        customLog(
                            'Installing React dependencies...'
                        )

                        npmInstall(
                            'frontend'
                        )
                    }
                }


                stage('Backend Dependencies') {

                    steps {

                        dir("${BACKEND_DIR}") {

                            customLog(
                                'Installing Spring Boot dependencies...'
                            )

                            bat '''
                                mvn dependency:go-offline

                                if %ERRORLEVEL% NEQ 0 (
                                    echo Maven dependency installation failed.
                                    exit /b %ERRORLEVEL%
                                )
                            '''
                        }
                    }
                }
            }
        }


        // ========================================================
        // 4. FRONTEND TEST
        // ========================================================

        stage('🧪 Frontend Tests') {

            steps {

                customLog(
                    'Running React tests with coverage...'
                )

                npmTest(
                    'frontend',
                    'vitest',
                    'coverage',
                    'junit.xml'
                )
            }
        }


        // ========================================================
        // 5. FRONTEND BUILD
        // ========================================================

        stage('🏗️ Frontend Build') {

            steps {

                customLog(
                    'Building React application...'
                )

                dir("${FRONTEND_DIR}") {

                    bat '''
                        echo ========================================
                        echo React Production Build
                        echo ========================================

                        npm run build

                        if %ERRORLEVEL% NEQ 0 (
                            echo React build failed.
                            exit /b %ERRORLEVEL%
                        )

                        if not exist "dist" (
                            echo ERROR: dist directory was not created.
                            exit /b 1
                        )

                        echo React build successful.
                    '''
                }
            }
        }


        // ========================================================
        // 6. BACKEND TEST + BUILD
        // ========================================================

        stage('🧪 Backend Test & Build') {

            steps {

                customLog(
                    'Running Spring Boot tests and build...'
                )

                dir("${BACKEND_DIR}") {

                    withCredentials([
                        file(
                            credentialsId: 'blogapplication-env',
                            variable: 'ENV_FILE'
                        )
                    ]) {

                        bat '''
                            echo ========================================
                            echo Creating .env
                            echo ========================================

                            copy /Y "%ENV_FILE%" ".env"

                            if %ERRORLEVEL% NEQ 0 (
                                echo Failed to create .env
                                exit /b %ERRORLEVEL%
                            )


                            echo.
                            echo ========================================
                            echo Maven Clean
                            echo ========================================

                            mvn clean

                            if %ERRORLEVEL% NEQ 0 (
                                echo Maven clean failed.
                                exit /b %ERRORLEVEL%
                            )


                            echo.
                            echo ========================================
                            echo Maven Test
                            echo ========================================

                            mvn test

                            if %ERRORLEVEL% NEQ 0 (
                                echo Backend tests failed.
                                exit /b %ERRORLEVEL%
                            )


                            echo.
                            echo ========================================
                            echo Maven Package
                            echo ========================================

                            mvn package -DskipTests

                            if %ERRORLEVEL% NEQ 0 (
                                echo Maven package failed.
                                exit /b %ERRORLEVEL%
                            )


                            echo.
                            echo ========================================
                            echo Verify Java Classes
                            echo ========================================

                            if not exist "target\\classes" (
                                echo ERROR: target\\classes not found.
                                exit /b 1
                            )

                            echo SUCCESS: target\\classes exists.


                            echo.
                            echo ========================================
                            echo Verify JAR
                            echo ========================================

                            dir "target\\*.jar"
                        '''
                    }
                }
            }
        }


        // ========================================================
        // 7. SONARQUBE ANALYSIS
        // ========================================================

        stage('🔍 SonarQube Analysis') {

            steps {

                customLog(
                    'Running SonarQube analysis...'
                )

                script {

                    def scannerHome =
                        tool 'SonarScanner'


                    withSonarQubeEnv('SonarQube') {

                        bat """
                            echo ========================================
                            echo SonarQube Analysis
                            echo ========================================

                            echo Scanner:
                            echo ${scannerHome}

                            echo.
                            echo Project:
                            echo ${SONAR_PROJECT_KEY}

                            echo.
                            echo Java binaries:
                            echo BlogApplication/target/classes

                            echo.
                            echo React coverage:
                            echo frontend/coverage/lcov.info

                            echo.
                            echo ========================================
                            echo Running Scanner
                            echo ========================================

                            "${scannerHome}\\bin\\sonar-scanner.bat" ^
                                -Dsonar.projectKey="${SONAR_PROJECT_KEY}" ^
                                -Dsonar.projectName="${APP_NAME}" ^
                                -Dsonar.projectVersion="${APP_VERSION}" ^
                                -Dsonar.sources="frontend/src,BlogApplication/src" ^
                                -Dsonar.exclusions="**/node_modules/**,**/dist/**,**/build/**,**/coverage/**,**/lcov-report/**,**/target/**,**/src/test/**,**/*.test.js,**/*.test.jsx,**/*.spec.js,**/*.spec.jsx" ^
                                -Dsonar.java.binaries="BlogApplication/target/classes" ^
                                -Dsonar.javascript.lcov.reportPaths="frontend/coverage/lcov.info" ^
                                -Dsonar.coverage.jacoco.xmlReportPaths="BlogApplication/target/site/jacoco/jacoco.xml" ^
                                -Dsonar.verbose=true

                            if %ERRORLEVEL% NEQ 0 (
                                echo.
                                echo ========================================
                                echo SonarQube Analysis FAILED
                                echo ========================================
                                exit /b %ERRORLEVEL%
                            )

                            echo.
                            echo ========================================
                            echo SonarQube Analysis Successful
                            echo ========================================
                        """
                    }
                }
            }
        }


        // ========================================================
        // 8. QUALITY GATE
        // ========================================================

        stage('✅ Quality Gate') {

            steps {

                customLog(
                    'Waiting for SonarQube quality gate...'
                )

                timeout(
                    time: 10,
                    unit: 'MINUTES'
                ) {

                    waitForQualityGate(
                        abortPipeline: true
                    )
                }
            }
        }


        // ========================================================
        // 9. DOCKER BUILD
        // ========================================================

        stage('🐳 Docker Build') {

            parallel {

                stage('Frontend Docker Build') {

                    steps {

                        customLog(
                            'Building frontend Docker image...'
                        )

                        bat """
                            docker build ^
                                -t ${FRONTEND_IMAGE}:${IMAGE_TAG} ^
                                -t ${FRONTEND_IMAGE}:latest ^
                                ${FRONTEND_DIR}

                            if %ERRORLEVEL% NEQ 0 (
                                echo Frontend Docker build failed.
                                exit /b %ERRORLEVEL%
                            )
                        """
                    }
                }


                stage('Backend Docker Build') {

                    steps {

                        customLog(
                            'Building Spring Boot Docker image...'
                        )

                        bat """
                            docker build ^
                                -t ${BACKEND_IMAGE}:${IMAGE_TAG} ^
                                -t ${BACKEND_IMAGE}:latest ^
                                ${BACKEND_DIR}

                            if %ERRORLEVEL% NEQ 0 (
                                echo Backend Docker build failed.
                                exit /b %ERRORLEVEL%
                            )
                        """
                    }
                }
            }
        }


        // ========================================================
        // 10. TRIVY SCAN
        // ========================================================

        stage('🛡️ Trivy Image Scan') {

            parallel {

                stage('Frontend Trivy Scan') {

                    steps {

                        customLog(
                            'Scanning frontend image...'
                        )

                        bat """
                            trivy image ^
                                --severity HIGH,CRITICAL ^
                                --format table ^
                                ${FRONTEND_IMAGE}:${IMAGE_TAG}

                            if %ERRORLEVEL% NEQ 0 (
                                echo Frontend Trivy scan failed.
                                exit /b %ERRORLEVEL%
                            )
                        """
                    }
                }


                stage('Backend Trivy Scan') {

                    steps {

                        customLog(
                            'Scanning backend image...'
                        )

                        bat """
                            trivy image ^
                                --severity HIGH,CRITICAL ^
                                --format table ^
                                ${BACKEND_IMAGE}:${IMAGE_TAG}

                            if %ERRORLEVEL% NEQ 0 (
                                echo Backend Trivy scan failed.
                                exit /b %ERRORLEVEL%
                            )
                        """
                    }
                }
            }
        }


        // ========================================================
        // 11. DOCKER LOGIN
        // ========================================================

        stage('🔐 Docker Login') {

            steps {

                customLog(
                    'Logging into Docker Hub...'
                )

                withCredentials([
                    usernamePassword(
                        credentialsId: 'dockerhub-credentials',
                        usernameVariable: 'DOCKER_USER',
                        passwordVariable: 'DOCKER_PASS'
                    )
                ]) {

                    bat '''
                        docker login ^
                            -u "%DOCKER_USER%" ^
                            -p "%DOCKER_PASS%"

                        if %ERRORLEVEL% NEQ 0 (
                            echo Docker login failed.
                            exit /b %ERRORLEVEL%
                        )
                    '''
                }
            }
        }


        // ========================================================
        // 12. PUSH IMAGES
        // ========================================================

        stage('📤 Push Docker Images') {

            parallel {

                stage('Push Frontend') {

                    steps {

                        customLog(
                            'Pushing frontend image...'
                        )

                        bat """
                            docker push ${FRONTEND_IMAGE}:${IMAGE_TAG}

                            if %ERRORLEVEL% NEQ 0 (
                                exit /b %ERRORLEVEL%
                            }

                            docker push ${FRONTEND_IMAGE}:latest
                        """
                    }
                }


                stage('Push Backend') {

                    steps {

                        customLog(
                            'Pushing backend image...'
                        )

                        bat """
                            docker push ${BACKEND_IMAGE}:${IMAGE_TAG}

                            if %ERRORLEVEL% NEQ 0 (
                                exit /b %ERRORLEVEL%
                            }

                            docker push ${BACKEND_IMAGE}:latest
                        """
                    }
                }
            }
        }
    }


    // ============================================================
    // POST
    // ============================================================

    post {

        success {

            customLog(
                '🎉 Pipeline completed successfully!'
            )

            echo """
            ========================================
            PIPELINE SUCCESS
            ========================================

            Application : ${APP_NAME}
            Version     : ${APP_VERSION}

            Frontend:
            ${FRONTEND_IMAGE}:${IMAGE_TAG}

            Backend:
            ${BACKEND_IMAGE}:${IMAGE_TAG}

            ========================================
            """
        }


        failure {

            customLog(
                '❌ Pipeline failed!'
            )

            echo """
            ========================================
            PIPELINE FAILED
            ========================================
            Check the failed stage.
            ========================================
            """
        }


        always {

            customLog(
                'Pipeline execution completed.'
            )
        }
    }
}