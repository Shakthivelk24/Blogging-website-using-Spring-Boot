pipeline {

    agent {
        label 'shakthiAgent'
    }

    options {
        timestamps()
        timeout(time: 1, unit: 'HOURS')
        disableConcurrentBuilds()
    }

    environment {

        // ============================================================
        // APPLICATION
        // ============================================================

        APP_NAME = 'sparkNote'

        APP_VERSION = "1.0.${BUILD_NUMBER}"

        FRONTEND_DIR = 'frontend'

        BACKEND_DIR = 'BlogApplication'


        // ============================================================
        // SONARQUBE
        // ============================================================

        SONAR_SERVER = 'SonarQube'

        SONAR_SCANNER = 'SonarScanner'

        SONAR_PROJECT_KEY = 'sparkNote'


        // ============================================================
        // DOCKER
        // ============================================================

        DOCKER_USERNAME = 'shakthivelk24'

        FRONTEND_IMAGE = 'shakthivelk24/sparknote-frontend'

        BACKEND_IMAGE = 'shakthivelk24/sparknote-backend'

        IMAGE_TAG = "${BUILD_NUMBER}"


        // ============================================================
        // TRIVY
        // ============================================================

        TRIVY_SEVERITY = 'HIGH,CRITICAL'
    }


    stages {


        // ============================================================
        // 1. CLEAN WORKSPACE
        // ============================================================

        stage('Clean Workspace') {

            steps {

                echo '========================================'
                echo 'Cleaning Jenkins Workspace'
                echo '========================================'

                cleanWs()
            }
        }


        // ============================================================
        // 2. CHECKOUT
        // ============================================================

        stage('Checkout') {

            steps {

                echo '========================================'
                echo 'Checking Out Source Code'
                echo '========================================'

                checkout([
                    $class: 'GitSCM',

                    branches: [[
                        name: '*/main'
                    ]],

                    userRemoteConfigs: [[
                        url: 'https://github.com/Shakthivelk24/Blogging-website-using-Spring-Boot.git'
                    ]]
                ])


                bat '''
                    echo.
                    echo ========================================
                    echo Git Information
                    echo ========================================

                    git --version

                    echo.
                    git branch

                    echo.
                    git log -1 --oneline

                    echo.
                    echo Repository files:
                    dir
                '''
            }
        }


        // ============================================================
        // 3. ENVIRONMENT CHECK
        // ============================================================

        stage('Environment Check') {

            steps {

                echo '========================================'
                echo 'Checking Build Environment'
                echo '========================================'

                bat '''
                    echo.
                    echo ---------- Java ----------
                    java -version

                    echo.
                    echo ---------- Maven ----------
                    mvn -version

                    echo.
                    echo ---------- Node ----------
                    node --version

                    echo.
                    echo ---------- NPM ----------
                    npm --version

                    echo.
                    echo ---------- Docker ----------
                    docker --version

                    echo.
                    echo ---------- Trivy ----------
                    trivy --version

                    echo.
                    echo ---------- Git ----------
                    git --version
                '''
            }
        }


        // ============================================================
        // 4. FRONTEND DEPENDENCIES
        // ============================================================

        stage('Frontend Dependencies') {

            steps {

                echo '========================================'
                echo 'Installing Frontend Dependencies'
                echo '========================================'

                dir("${FRONTEND_DIR}") {

                    bat '''
                        echo Installing npm dependencies...

                        if exist package-lock.json (
                            npm ci
                        ) else (
                            npm install
                        )
                    '''
                }
            }
        }


        // ============================================================
        // 5. FRONTEND TEST
        // ============================================================

        stage('Frontend Test') {

            steps {

                echo '========================================'
                echo 'Running Frontend Tests'
                echo '========================================'

                dir("${FRONTEND_DIR}") {

                    bat '''
                        echo Checking frontend project...

                        npm run test --if-present
                    '''
                }
            }
        }


        // ============================================================
        // 6. FRONTEND BUILD
        // ============================================================

        stage('Frontend Build') {

            steps {

                echo '========================================'
                echo 'Building React Frontend'
                echo '========================================'

                dir("${FRONTEND_DIR}") {

                    bat '''
                        echo Building React application...

                        npm run build

                        if %ERRORLEVEL% NEQ 0 (
                            echo Frontend build failed.
                            exit /b %ERRORLEVEL%
                        )

                        echo.
                        echo Frontend build completed successfully.

                        if not exist dist (
                            echo ERROR: dist directory was not created.
                            exit /b 1
                        )

                        dir dist
                    '''
                }
            }
        }


        // ============================================================
        // 7. BACKEND TEST & BUILD
        // ============================================================

        stage('Backend Test & Build') {

            steps {

                echo '========================================'
                echo 'Backend Test & Build'
                echo '========================================'

                dir("${BACKEND_DIR}") {

                    withCredentials([
                        file(
                            credentialsId: 'blogapplication-env',
                            variable: 'ENV_FILE'
                        )
                    ]) {

                        bat '''
                            echo ========================================
                            echo Creating backend .env
                            echo ========================================

                            copy /Y "%ENV_FILE%" ".env"

                            if %ERRORLEVEL% NEQ 0 (
                                echo Failed to create .env file.
                                exit /b %ERRORLEVEL%
                            )

                            echo.
                            echo ========================================
                            echo Maven Clean
                            echo ========================================

                            mvn clean

                            if %ERRORLEVEL% NEQ 0 (
                                echo Maven clean failed.
                                exit /b %ERRORLEVEL%
                            )

                            echo.
                            echo ========================================
                            echo Maven Test
                            echo ========================================

                            mvn test

                            if %ERRORLEVEL% NEQ 0 (
                                echo Backend tests failed.
                                exit /b %ERRORLEVEL%
                            )

                            echo.
                            echo ========================================
                            echo Maven Package
                            echo ========================================

                            mvn package -DskipTests

                            if %ERRORLEVEL% NEQ 0 (
                                echo Maven package failed.
                                exit /b %ERRORLEVEL%
                            )

                            echo.
                            echo ========================================
                            echo Checking Compiled Classes
                            echo ========================================

                            if not exist "target\\classes" (
                                echo ERROR: target/classes was not created.
                                exit /b 1
                            )

                            echo Java compiled classes found:

                            dir "target\\classes"

                            echo.
                            echo ========================================
                            echo Checking JAR
                            echo ========================================

                            dir "target\\*.jar"
                        '''
                    }
                }
            }
        }


        // ============================================================
        // 8. JACOCO CHECK
        // ============================================================
        //
        // IMPORTANT:
        // We DO NOT run:
        //
        //     mvn jacoco:report
        //
        // because the current project does not have the JaCoCo
        // Maven plugin available.
        //
        // Instead, we only check whether a report exists.
        //
        // ============================================================

        stage('JaCoCo Coverage Check') {

            steps {

                echo '========================================'
                echo 'Checking JaCoCo Coverage'
                echo '========================================'

                dir("${BACKEND_DIR}") {

                    bat '''
                        echo Checking for JaCoCo report...

                        if exist "target\\site\\jacoco\\jacoco.xml" (

                            echo JaCoCo XML report found.

                        ) else (

                            echo JaCoCo XML report not found.
                            echo Continuing without coverage data.
                        )
                    '''
                }
            }
        }


        // ============================================================
        // 9. SONARQUBE ANALYSIS
        // ============================================================

        stage('SonarQube Analysis') {

            steps {

                echo '========================================'
                echo 'Running SonarQube Analysis'
                echo '========================================'

                script {

                    def scannerHome = tool(
                        name: "${SONAR_SCANNER}",
                        type: 'hudson.plugins.sonar.SonarRunnerInstallation'
                    )

                    withSonarQubeEnv("${SONAR_SERVER}") {

                        bat """
                            echo ========================================
                            echo SonarQube Scanner
                            echo ========================================

                            "${scannerHome}\\\\bin\\\\sonar-scanner.bat" ^
                                -Dsonar.projectKey=${SONAR_PROJECT_KEY} ^
                                -Dsonar.projectName=${APP_NAME} ^
                                -Dsonar.projectVersion=${APP_VERSION} ^
                                -Dsonar.sources=frontend/src,BlogApplication/src ^
                                -Dsonar.java.binaries=BlogApplication/target/classes ^
                                -Dsonar.exclusions=**/node_modules/**,**/dist/**,**/build/**,**/coverage/**,**/lcov-report/**,**/target/**,**/*.test.js,**/*.test.jsx,**/*.spec.js,**/*.spec.jsx,**/src/test/** ^
                                -Dsonar.verbose=false
                        """
                    }
                }
            }
        }


        // ============================================================
        // 10. SONARQUBE QUALITY GATE
        // ============================================================

        stage('SonarQube Quality Gate') {

            steps {

                echo '========================================'
                echo 'Waiting for SonarQube Quality Gate'
                echo '========================================'

                timeout(time: 10, unit: 'MINUTES') {

                    waitForQualityGate(
                        abortPipeline: true
                    )
                }
            }
        }


        // ============================================================
        // 11. DOCKER BUILD - FRONTEND
        // ============================================================

        stage('Docker Build - Frontend') {

            steps {

                echo '========================================'
                echo 'Building Frontend Docker Image'
                echo '========================================'

                bat """
                    docker build ^
                        -t ${FRONTEND_IMAGE}:${IMAGE_TAG} ^
                        -t ${FRONTEND_IMAGE}:latest ^
                        -f docker/frontend/Dockerfile ^
                        frontend
                """

                bat """
                    docker images ${FRONTEND_IMAGE}
                """
            }
        }


        // ============================================================
        // 12. DOCKER BUILD - BACKEND
        // ============================================================

        stage('Docker Build - Backend') {

            steps {

                echo '========================================'
                echo 'Building Backend Docker Image'
                echo '========================================'

                bat """
                    docker build ^
                        -t ${BACKEND_IMAGE}:${IMAGE_TAG} ^
                        -t ${BACKEND_IMAGE}:latest ^
                        -f docker/backend/Dockerfile ^
                        BlogApplication
                """

                bat """
                    docker images ${BACKEND_IMAGE}
                """
            }
        }


        // ============================================================
        // 13. TRIVY SCAN - FRONTEND
        // ============================================================

        stage('Trivy Scan - Frontend') {

            steps {

                echo '========================================'
                echo 'Scanning Frontend Docker Image'
                echo '========================================'

                bat """
                    trivy image ^
                        --severity ${TRIVY_SEVERITY} ^
                        --exit-code 0 ^
                        ${FRONTEND_IMAGE}:${IMAGE_TAG}
                """
            }
        }


        // ============================================================
        // 14. TRIVY SCAN - BACKEND
        // ============================================================

        stage('Trivy Scan - Backend') {

            steps {

                echo '========================================'
                echo 'Scanning Backend Docker Image'
                echo '========================================'

                bat """
                    trivy image ^
                        --severity ${TRIVY_SEVERITY} ^
                        --exit-code 0 ^
                        ${BACKEND_IMAGE}:${IMAGE_TAG}
                """
            }
        }


        // ============================================================
        // 15. DOCKER LOGIN
        // ============================================================

        stage('Docker Login') {

            steps {

                echo '========================================'
                echo 'Logging into Docker Hub'
                echo '========================================'

                withCredentials([
                    usernamePassword(
                        credentialsId: 'dockerhub-credentials',
                        usernameVariable: 'DOCKER_USER',
                        passwordVariable: 'DOCKER_PASSWORD'
                    )
                ]) {

                    bat '''
                        echo %DOCKER_PASSWORD% | docker login -u %DOCKER_USER% --password-stdin

                        if %ERRORLEVEL% NEQ 0 (
                            echo Docker login failed.
                            exit /b %ERRORLEVEL%
                        )
                    '''
                }
            }
        }


        // ============================================================
        // 16. PUSH FRONTEND IMAGE
        // ============================================================

        stage('Push Frontend Image') {

            steps {

                echo '========================================'
                echo 'Pushing Frontend Docker Image'
                echo '========================================'

                bat """
                    docker push ${FRONTEND_IMAGE}:${IMAGE_TAG}

                    if %ERRORLEVEL% NEQ 0 (
                        exit /b %ERRORLEVEL%
                    )

                    docker push ${FRONTEND_IMAGE}:latest
                """
            }
        }


        // ============================================================
        // 17. PUSH BACKEND IMAGE
        // ============================================================

        stage('Push Backend Image') {

            steps {

                echo '========================================'
                echo 'Pushing Backend Docker Image'
                echo '========================================'

                bat """
                    docker push ${BACKEND_IMAGE}:${IMAGE_TAG}

                    if %ERRORLEVEL% NEQ 0 (
                        exit /b %ERRORLEVEL%
                    )

                    docker push ${BACKEND_IMAGE}:latest
                """
            }
        }


        // ============================================================
        // 18. DOCKER IMAGE SUMMARY
        // ============================================================

        stage('Docker Image Summary') {

            steps {

                echo '========================================'
                echo 'Docker Image Summary'
                echo '========================================'

                bat """
                    echo.
                    echo ========================================
                    echo FRONTEND IMAGE
                    echo ========================================

                    echo ${FRONTEND_IMAGE}:${IMAGE_TAG}

                    docker image inspect ${FRONTEND_IMAGE}:${IMAGE_TAG} --format="{{.Id}}"

                    echo.
                    echo ========================================
                    echo BACKEND IMAGE
                    echo ========================================

                    echo ${BACKEND_IMAGE}:${IMAGE_TAG}

                    docker image inspect ${BACKEND_IMAGE}:${IMAGE_TAG} --format="{{.Id}}"

                    echo.
                    echo ========================================
                    echo BUILD NUMBER
                    echo ========================================

                    echo ${BUILD_NUMBER}

                    echo.
                    echo ========================================
                    echo IMAGE TAG
                    echo ========================================

                    echo ${IMAGE_TAG}
                """
            }
        }
    }


    // ================================================================
    // POST ACTIONS
    // ================================================================

    post {

        always {

            echo '========================================'
            echo 'Cleaning Sensitive Files'
            echo '========================================'

            bat '''
                if exist "BlogApplication\\.env" (
                    del /F /Q "BlogApplication\\.env"
                )

                if exist "frontend\\.env" (
                    del /F /Q "frontend\\.env"
                )
            '''

            echo 'Pipeline execution completed.'
        }


        success {

            echo '''
            ========================================
            PIPELINE SUCCESS
            ========================================
            '''

            echo "Application : ${APP_NAME}"
            echo "Version     : ${APP_VERSION}"
            echo "Build       : ${BUILD_NUMBER}"

            echo "Frontend    : ${FRONTEND_IMAGE}:${IMAGE_TAG}"
            echo "Backend     : ${BACKEND_IMAGE}:${IMAGE_TAG}"
        }


        failure {

            echo '''
            ========================================
            PIPELINE FAILED
            ========================================
            '''

            echo "Build Number: ${BUILD_NUMBER}"
            echo "Check Jenkins Console Output."
        }


        unstable {

            echo '''
            ========================================
            PIPELINE UNSTABLE
            ========================================
            '''

            echo "Build Number: ${BUILD_NUMBER}"
        }
    }
}