@Library('Shared') _

pipeline {

    agent {
        label 'shakthiAgent'
    }

    // ============================================================
    // ENVIRONMENT
    // ============================================================

    environment {

        // Application
        APP_NAME = 'sparkNote'
        APP_VERSION = "1.0.${BUILD_NUMBER}"

        // Docker
        DOCKER_USERNAME = 'shakthivelk24'

        FRONTEND_IMAGE = "${DOCKER_USERNAME}/sparknote-frontend"
        BACKEND_IMAGE  = "${DOCKER_USERNAME}/sparknote-backend"

        IMAGE_TAG = "${BUILD_NUMBER}"

        // SonarQube
        SONAR_PROJECT_KEY  = 'sparkNote'
        SONAR_PROJECT_NAME = 'sparkNote'

        // Trivy
        TRIVY_REPORT_DIR = 'reports/trivy'
    }

    // ============================================================
    // OPTIONS
    // ============================================================

    options {

        timestamps()

        ansiColor('xterm')

        timeout(
            time: 60,
            unit: 'MINUTES'
        )

        buildDiscarder(
            logRotator(
                numToKeepStr: '10'
            )
        )

        disableConcurrentBuilds()
    }

    // ============================================================
    // STAGES
    // ============================================================

    stages {

        // ========================================================
        // 1. CHECK TOOLS
        // ========================================================

        stage('🔧 Check Tools') {

            steps {

                cleanWs()

                customLog(
                    'Checking required tools...'
                )

                check()
            }
        }

        // ========================================================
        // 2. CHECKOUT
        // ========================================================

        stage('🔄 Checkout') {

            steps {

                customLog(
                    'Checking out source code...'
                )

                checkout scm

                bat '''
                    echo ========================================
                    echo Git Information
                    echo ========================================

                    git --version

                    echo.
                    echo Last 5 Commits
                    git log --oneline -5

                    echo.
                    echo Git Status
                    git status
                '''
            }
        }

        // ========================================================
        // 3. INSTALL DEPENDENCIES
        // ========================================================

        stage('📦 Install Dependencies') {

            parallel {

                // ------------------------------------------------
                // FRONTEND
                // ------------------------------------------------

                stage('Frontend Dependencies') {

                    steps {

                        customLog(
                            'Installing frontend dependencies...'
                        )

                        npmInstall('frontend')
                    }
                }

                // ------------------------------------------------
                // BACKEND
                // ------------------------------------------------

                stage('Backend Dependencies') {

                    steps {

                        dir('BlogApplication') {

                            customLog(
                                'Installing Spring Boot dependencies...'
                            )

                            bat '''
                                echo ========================================
                                echo Maven Dependency Check
                                echo ========================================

                                mvn dependency:go-offline
                            '''
                        }
                    }
                }
            }
        }

        // ========================================================
        // 4. FRONTEND TESTS + COVERAGE
        // ========================================================

        stage('🧪 Frontend Tests & Coverage') {

            steps {

                dir('frontend') {

                    customLog(
                        'Running React tests with coverage...'
                    )

                    bat '''
                        echo ========================================
                        echo Frontend Tests
                        echo ========================================

                        npm run coverage
                    '''

                    script {

                        if (fileExists('coverage/lcov.info')) {

                            echo '''
                            ====================
                            Coverage report found:
                            coverage/lcov.info
                            ====================
                            '''

                        } else {

                            error(
                                'Frontend coverage file was not generated.'
                            )
                        }
                    }
                }
            }
        }

        // ========================================================
        // 5. FRONTEND BUILD
        // ========================================================

        stage('🏗️ Frontend Build') {

            steps {

                customLog(
                    'Building React application...'
                )

                dir('frontend') {

                    bat '''
                        echo ========================================
                        echo React Production Build
                        echo ========================================

                        npm run build
                    '''
                }
            }
        }

        // ========================================================
        // 6. BACKEND TEST + BUILD
        // ========================================================

        stage('🧪 Backend Test & Build') {

            steps {

                customLog(
                    'Running Spring Boot tests and build...'
                )

                dir('BlogApplication') {

                    withCredentials([
                        file(
                            credentialsId: 'blogapplication-env',
                            variable: 'ENV_FILE'
                        )
                    ]) {

                        bat '''
                            echo ========================================
                            echo Creating .env
                            echo ========================================

                            copy /Y "%ENV_FILE%" ".env"

                            if %ERRORLEVEL% NEQ 0 (
                                echo Failed to create .env
                                exit /b 1
                            )

                            echo.
                            echo ========================================
                            echo Maven Clean
                            echo ========================================

                            mvn clean

                            echo.
                            echo ========================================
                            echo Maven Test + Package
                            echo ========================================

                            mvn test package

                            if %ERRORLEVEL% NEQ 0 (
                                echo Backend tests/build failed
                                exit /b 1
                            )

                            echo.
                            echo ========================================
                            echo Backend Build Completed
                            echo ========================================

                            if not exist "target\\classes" (
                                echo ERROR: target/classes was not created.
                                exit /b 1
                            )

                            echo Java classes found:
                            dir "target\\classes"
                        '''
                    }
                }
            }
        }

        // ========================================================
        // 7. SONARQUBE ANALYSIS
        // ========================================================

        stage('🔍 SonarQube Analysis') {

            steps {

                customLog(
                    'Running SonarQube analysis...'
                )

                script {

                    def scannerHome =
                        tool 'SonarScanner'

                    withSonarQubeEnv('SonarQube') {

                        bat """
                            echo ========================================
                            echo SonarQube Analysis
                            echo ========================================

                            echo Scanner:
                            echo ${scannerHome}

                            echo.
                            echo Project:
                            echo ${SONAR_PROJECT_NAME}

                            echo.
                            echo Java binaries:
                            echo BlogApplication/target/classes

                            echo.
                            echo React coverage:
                            echo frontend/coverage/lcov.info

                            echo.
                            echo ========================================
                            echo Running Scanner
                            echo ========================================

                            "${scannerHome}\\\\bin\\\\sonar-scanner.bat" ^
                                -Dsonar.projectKey="${SONAR_PROJECT_KEY}" ^
                                -Dsonar.projectName="${SONAR_PROJECT_NAME}" ^
                                -Dsonar.projectVersion="${APP_VERSION}" ^
                                -Dsonar.sources="frontend/src,BlogApplication/src" ^
                                -Dsonar.exclusions="**/node_modules/**,**/dist/**,**/build/**,**/coverage/**,**/lcov-report/**,**/target/**,**/src/test/**,**/*.test.js,**/*.test.jsx,**/*.spec.js,**/*.spec.jsx" ^
                                -Dsonar.java.binaries="BlogApplication/target/classes" ^
                                -Dsonar.javascript.lcov.reportPaths="frontend/coverage/lcov.info" ^
                                -Dsonar.coverage.jacoco.xmlReportPaths="BlogApplication/target/site/jacoco/jacoco.xml" ^
                                -Dsonar.scanner.skipSystemTruststore=true
                        """
                    }
                }
            }
        }

        // ========================================================
        // 8. QUALITY GATE
        // ========================================================

        stage('✅ Quality Gate') {

            steps {

                customLog(
                    'Waiting for SonarQube quality gate result...'
                )

                timeout(
                    time: 10,
                    unit: 'MINUTES'
                ) {

                    waitForQualityGate(
                        abortPipeline: true
                    )
                }
            }
        }

        // ========================================================
        // 9. VERIFY BUILD OUTPUTS
        // ========================================================

        stage('🔎 Verify Build Outputs') {

            steps {

                customLog(
                    'Verifying generated application artifacts...'
                )

                bat '''
                    echo ========================================
                    echo Frontend Build
                    echo ========================================

                    if not exist "frontend\\dist" (
                        echo ERROR: Frontend dist folder not found.
                        exit /b 1
                    )

                    dir "frontend\\dist"

                    echo.
                    echo ========================================
                    echo Backend Build
                    echo ========================================

                    if not exist "BlogApplication\\target" (
                        echo ERROR: Backend target folder not found.
                        exit /b 1
                    )

                    dir "BlogApplication\\target"

                    echo.
                    echo ========================================
                    echo Build Verification Successful
                    echo ========================================
                '''
            }
        }
    }

    // ============================================================
    // POST ACTIONS
    // ============================================================

    post {

        success {

            customLog(
                '🎉 Pipeline completed successfully!'
            )
        }

        failure {

            customLog(
                '❌ Pipeline failed!'
            )
        }

        always {

            customLog(
                'Pipeline execution completed.'
            )

            // Remove generated .env file
            // so secrets are not left inside workspace.

            bat '''
                if exist "BlogApplication\\.env" (
                    del /F /Q "BlogApplication\\.env"
                    echo .env removed from workspace.
                )
            '''
        }
    }
}