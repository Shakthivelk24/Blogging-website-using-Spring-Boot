@Library('Shared') _

pipeline {

    // ============================================================
    // AGENT
    // ============================================================

    agent {
        label 'shakthiAgent'
    }

    // ============================================================
    // ENVIRONMENT
    // ============================================================

    environment {

        // Application
        APP_NAME = 'sparkNote'
        APP_VERSION = "1.0.${BUILD_NUMBER}"

        // Docker
        DOCKER_USERNAME = 'shakthivelk24'

        FRONTEND_IMAGE =
            "${DOCKER_USERNAME}/sparknote-frontend"

        BACKEND_IMAGE =
            "${DOCKER_USERNAME}/sparknote-backend"

        IMAGE_TAG =
            "${BUILD_NUMBER}"

        // SonarQube
        SONAR_PROJECT_KEY = 'sparkNote'

        // Trivy
        TRIVY_REPORT_DIR =
            'reports/trivy'
    }

    // ============================================================
    // PIPELINE OPTIONS
    // ============================================================

    options {

        timestamps()

        ansiColor('xterm')

        timeout(
            time: 60,
            unit: 'MINUTES'
        )

        buildDiscarder(
            logRotator(
                numToKeepStr: '10'
            )
        )

        disableConcurrentBuilds()
    }

    // ============================================================
    // STAGES
    // ============================================================

    stages {

        // ========================================================
        // STAGE 1: CHECK TOOLS
        // ========================================================

        stage('🔧 Check Tools') {

            steps {

                cleanWs()

                customLog(
                    'Checking required tools...'
                )

                check()
            }
        }

        // ========================================================
        // STAGE 2: CHECKOUT
        // ========================================================

        stage('🔄 Checkout') {

            steps {

                customLog(
                    'Checking out source code...'
                )

                checkout scm

                script {

                    if (isUnix()) {

                        sh '''
                            echo "========== Last 5 Commits =========="

                            git log --oneline -5

                            echo "========== Git Status =========="

                            git status
                        '''

                    } else {

                        bat '''
                            echo ========== Last 5 Commits ==========

                            git log --oneline -5

                            echo ========== Git Status ==========

                            git status
                        '''
                    }
                }
            }
        }

        // ========================================================
        // STAGE 3: INSTALL DEPENDENCIES
        // ========================================================

        stage('📦 Install Dependencies') {

            parallel {

                // ------------------------------------------------
                // FRONTEND
                // ------------------------------------------------

                stage('Frontend Dependencies') {

                    steps {

                        customLog(
                            'Installing React dependencies...'
                        )

                        npmInstall(
                            'frontend'
                        )
                    }
                }

                // ------------------------------------------------
                // SPRING BOOT
                // ------------------------------------------------

                stage('Backend Dependencies') {

                    steps {

                        dir('BlogApplication') {

                            customLog(
                                'Installing Spring Boot dependencies...'
                            )

                            script {

                                if (isUnix()) {

                                    sh '''
                                        mvn dependency:go-offline
                                    '''

                                } else {

                                    bat '''
                                        mvn dependency:go-offline
                                    '''
                                }
                            }
                        }
                    }
                }
            }
        }

        // ========================================================
        // STAGE 4: RUN TESTS
        // ========================================================

        stage('🧪 Run Tests') {

            parallel {

                // ------------------------------------------------
                // FRONTEND TESTS
                // ------------------------------------------------

                stage('Frontend Tests') {

                    steps {

                        customLog(
                            'Running React tests with coverage...'
                        )

                        npmTest(
                            'frontend',
                            'vitest',
                            'coverage',
                            'junit.xml'
                        )
                    }
                }

                // ------------------------------------------------
                // SPRING BOOT TESTS
                // ------------------------------------------------

                stage('Backend Tests') {

                    steps {

                        dir('BlogApplication') {

                            withCredentials([

                                file(
                                    credentialsId:
                                        'blogapplication-env',

                                    variable:
                                        'ENV_FILE'
                                )

                            ]) {

                                script {

                                    if (isUnix()) {

                                        sh '''
                                            echo "Creating Spring Boot .env file..."

                                            cp "$ENV_FILE" .env

                                            echo "Running Spring Boot tests..."

                                            mvn clean test
                                        '''

                                    } else {

                                        bat '''
                                            echo Creating Spring Boot .env file...

                                            copy /Y "%ENV_FILE%" .env

                                            echo Running Spring Boot tests...

                                            mvn clean test
                                        '''
                                    }
                                }
                            }
                        }
                    }
                }
            }
        }

        // ========================================================
        // STAGE 5: STATIC CODE ANALYSIS
        // ========================================================

        stage('🔍 Static Code Analysis') {

            steps {

                customLog(
                    'Running SonarQube analysis for React + Spring Boot...'
                )

                script {

                    def scannerHome =
                        tool 'SonarScanner'

                    withSonarQubeEnv('SonarQube') {

                        if (isUnix()) {

                            sh """
                                "${scannerHome}/bin/sonar-scanner" \
                                -Dsonar.projectKey="${SONAR_PROJECT_KEY}" \
                                -Dsonar.projectName="${APP_NAME}" \
                                -Dsonar.projectVersion="${APP_VERSION}" \
                                -Dsonar.sources="frontend/src,BlogApplication/src" \
                                -Dsonar.exclusions="**/node_modules/**,**/dist/**,**/build/**,**/coverage/**,**/lcov-report/**,**/target/**,**/*.test.js,**/*.test.jsx,**/*.spec.js,**/*.spec.jsx,**/src/test/**" \
                                -Dsonar.javascript.lcov.reportPaths="frontend/coverage/lcov.info" \
                                -Dsonar.java.binaries="BlogApplication/target/classes" \
                                -Dsonar.coverage.jacoco.xmlReportPaths="BlogApplication/target/site/jacoco/jacoco.xml" \
                                -Dsonar.verbose=true
                            """

                        } else {

                            bat """
                                "${scannerHome}\\bin\\sonar-scanner.bat" ^
                                -Dsonar.projectKey="${SONAR_PROJECT_KEY}" ^
                                -Dsonar.projectName="${APP_NAME}" ^
                                -Dsonar.projectVersion="${APP_VERSION}" ^
                                -Dsonar.sources="frontend/src,BlogApplication/src" ^
                                -Dsonar.exclusions="**/node_modules/**,**/dist/**,**/build/**,**/coverage/**,**/lcov-report/**,**/target/**,**/*.test.js,**/*.test.jsx,**/*.spec.js,**/*.spec.jsx,**/src/test/**" ^
                                -Dsonar.javascript.lcov.reportPaths="frontend/coverage/lcov.info" ^
                                -Dsonar.java.binaries="BlogApplication/target/classes" ^
                                -Dsonar.coverage.jacoco.xmlReportPaths="BlogApplication/target/site/jacoco/jacoco.xml" ^
                                -Dsonar.verbose=true
                            """
                        }
                    }
                }
            }
        }

        // ========================================================
        // STAGE 6: QUALITY GATE
        // ========================================================

        stage('✅ Quality Gate') {

            steps {

                customLog(
                    'Waiting for SonarQube quality gate result...'
                )

                qualityGate()
            }
        }

        // ========================================================
        // STAGE 7: BUILD APPLICATION
        // ========================================================

        stage('🏗️ Build Application') {

            steps {

                customLog(
                    'Building React frontend...'
                )

                frontendBuild(
                    'frontend'
                )
            }
        }

        // ========================================================
        // STAGE 8: DOCKER LOGIN
        // ========================================================

        stage('🔑 Docker Login') {

            steps {

                customLog(
                    'Logging in to Docker Hub...'
                )

                dockerLogin()
            }
        }

        // ========================================================
        // STAGE 9: BUILD DOCKER IMAGES
        // ========================================================

        stage('🐳 Build Docker Images') {

            parallel {

                // ------------------------------------------------
                // FRONTEND IMAGE
                // ------------------------------------------------

                stage('Build Frontend Image') {

                    steps {

                        customLog(
                            'Building frontend Docker image...'
                        )

                        dockerBuild(
                            FRONTEND_IMAGE,
                            'docker/frontend/Dockerfile',
                            '.',
                            IMAGE_TAG
                        )
                    }
                }

                // ------------------------------------------------
                // BACKEND IMAGE
                // ------------------------------------------------

                stage('Build Backend Image') {

                    steps {

                        customLog(
                            'Building backend Docker image...'
                        )

                        dockerBuild(
                            BACKEND_IMAGE,
                            'docker/backend/Dockerfile',
                            '.',
                            IMAGE_TAG
                        )
                    }
                }
            }
        }

        // ========================================================
        // STAGE 10: TRIVY IMAGE SCAN
        // ========================================================

        stage('🛡️ Trivy Image Scan') {

            parallel {

                // ------------------------------------------------
                // FRONTEND SCAN
                // ------------------------------------------------

                stage('Scan Frontend Image') {

                    steps {

                        trivyScan(

                            imageName:
                                FRONTEND_IMAGE,

                            imageVersion:
                                IMAGE_TAG,

                            reportDir:
                                TRIVY_REPORT_DIR,

                            reportName:
                                'frontend'
                        )
                    }
                }

                // ------------------------------------------------
                // BACKEND SCAN
                // ------------------------------------------------

                stage('Scan Backend Image') {

                    steps {

                        trivyScan(

                            imageName:
                                BACKEND_IMAGE,

                            imageVersion:
                                IMAGE_TAG,

                            reportDir:
                                TRIVY_REPORT_DIR,

                            reportName:
                                'backend'
                        )
                    }
                }
            }
        }
    }

    // ============================================================
    // POST ACTIONS
    // ============================================================

    post {

        success {

            customLog(
                '🎉 React + Spring Boot pipeline completed successfully!'
            )
        }

        failure {

            customLog(
                '❌ Pipeline failed!'
            )
        }

        always {

            customLog(
                'Pipeline execution completed.'
            )
        }
    }
}