pipeline {

    agent {
        label 'shakthiAgent'
    }

    options {
        timestamps()
        disableConcurrentBuilds()
        skipDefaultCheckout(true)
        timeout(time: 60, unit: 'MINUTES')
    }

    environment {

        // ============================================================
        // APPLICATION
        // ============================================================

        APP_NAME = 'sparkNote'

        // Jenkins build number used as image/version tag
        APP_VERSION = "${BUILD_NUMBER}"

        // ============================================================
        // GITHUB
        // ============================================================

        GIT_URL = 'https://github.com/Shakthivelk24/Blogging-website-using-Spring-Boot.git'

        // ============================================================
        // SONARQUBE
        // ============================================================

        SONAR_PROJECT_KEY = 'sparkNote'

        // Jenkins -> Manage Jenkins -> System -> SonarQube
        SONAR_SERVER = 'SonarQube'

        // Jenkins -> Tools -> SonarQube Scanner installations
        SONAR_SCANNER = 'SonarScanner'

        // ============================================================
        // DOCKER
        // ============================================================

        DOCKERHUB_USERNAME = 'shakthivelk24'

        FRONTEND_IMAGE =
            "${DOCKERHUB_USERNAME}/sparknote-frontend"

        BACKEND_IMAGE =
            "${DOCKERHUB_USERNAME}/sparknote-backend"

        // ============================================================
        // PATHS
        // ============================================================

        FRONTEND_DIR = 'frontend'

        BACKEND_DIR = 'BlogApplication'

        // ============================================================
        // JAVA
        // ============================================================

        JAVA_HOME = 'C:\\Program Files\\Java\\jdk-25.0.2'

        // ============================================================
        // NODE
        // ============================================================

        NODE_HOME = 'C:\\Program Files\\nodejs'

        PATH = "${JAVA_HOME}\\bin;${NODE_HOME};${PATH}"
    }


    stages {

        // ============================================================
        // 1. CLEAN WORKSPACE
        // ============================================================

        stage('Clean Workspace') {

            steps {

                echo '========================================'
                echo 'Cleaning Jenkins Workspace'
                echo '========================================'

                cleanWs()
            }
        }


        // ============================================================
        // 2. CHECKOUT
        // ============================================================

        stage('Checkout') {

            steps {

                echo '========================================'
                echo 'Checking Out Source Code'
                echo '========================================'

                checkout([
                    $class: 'GitSCM',

                    branches: [
                        [
                            name: '*/main'
                        ]
                    ],

                    userRemoteConfigs: [
                        [
                            url: "${GIT_URL}"
                        ]
                    ]
                ])

                bat '''
                    echo ========================================
                    echo Git Information
                    echo ========================================

                    git --version
                    git branch
                    git log -1 --oneline

                    echo.
                    echo Repository files:
                    dir
                '''
            }
        }


        // ============================================================
        // 3. ENVIRONMENT CHECK
        // ============================================================

        stage('Environment Check') {

            steps {

                echo '========================================'
                echo 'Checking Build Environment'
                echo '========================================'

                bat '''
                    echo.
                    echo ---------- Java ----------
                    java -version

                    echo.
                    echo ---------- Maven ----------
                    mvn -version

                    echo.
                    echo ---------- Node ----------
                    node --version

                    echo.
                    echo ---------- NPM ----------
                    npm --version

                    echo.
                    echo ---------- Docker ----------
                    docker --version

                    echo.
                    echo ---------- Trivy ----------
                    trivy --version
                '''
            }
        }


        // ============================================================
        // 4. FRONTEND DEPENDENCIES
        // ============================================================

        stage('Frontend Dependencies') {

            steps {

                echo '========================================'
                echo 'Installing Frontend Dependencies'
                echo '========================================'

                dir("${FRONTEND_DIR}") {

                    bat '''
                        echo Installing npm dependencies...

                        if exist package-lock.json (
                            npm ci
                        ) else (
                            npm install
                        )
                    '''
                }
            }
        }


        // ============================================================
        // 5. FRONTEND TEST
        // ============================================================

        stage('Frontend Test') {

            steps {

                echo '========================================'
                echo 'Running Frontend Tests'
                echo '========================================'

                dir("${FRONTEND_DIR}") {

                    bat '''
                        echo Checking frontend project...

                        npm run test --if-present
                    '''
                }
            }
        }


        // ============================================================
        // 6. FRONTEND BUILD
        // ============================================================

        stage('Frontend Build') {

            steps {

                echo '========================================'
                echo 'Building React Frontend'
                echo '========================================'

                dir("${FRONTEND_DIR}") {

                    bat '''
                        echo Building React application...

                        npm run build

                        echo.
                        echo Checking build output...

                        if exist dist (
                            dir dist
                        ) else (
                            echo ERROR: dist directory was not created
                            exit /b 1
                        )
                    '''
                }
            }
        }


        // ============================================================
        // 7. BACKEND TEST + COMPILE + PACKAGE
        // ============================================================
        //
        // IMPORTANT:
        //
        // This stage MUST execute BEFORE SonarQube.
        //
        // SonarQube requires:
        //
        // BlogApplication/target/classes
        //
        // for Java analysis.
        //
        // ============================================================

        stage('Backend Test & Build') {

            steps {

                echo '========================================'
                echo 'Backend Test & Build'
                echo '========================================'

                dir("${BACKEND_DIR}") {

                    withCredentials([
                        file(
                            credentialsId: 'blogapplication-env',
                            variable: 'ENV_FILE'
                        )
                    ]) {

                        bat '''
                            echo ========================================
                            echo Creating backend .env
                            echo ========================================

                            copy /Y "%ENV_FILE%" ".env"

                            echo.
                            echo ========================================
                            echo Maven Clean
                            echo ========================================

                            mvn clean

                            echo.
                            echo ========================================
                            echo Maven Test
                            echo ========================================

                            mvn test

                            if %ERRORLEVEL% NEQ 0 (
                                echo Backend tests failed
                                exit /b %ERRORLEVEL%
                            )

                            echo.
                            echo ========================================
                            echo Maven Package
                            echo ========================================

                            mvn package -DskipTests

                            if %ERRORLEVEL% NEQ 0 (
                                echo Maven package failed
                                exit /b %ERRORLEVEL%
                            )

                            echo.
                            echo ========================================
                            echo Checking Compiled Classes
                            echo ========================================

                            if not exist "target\\classes" (
                                echo ERROR: target/classes does not exist
                                echo SonarQube cannot analyze Java code
                                exit /b 1
                            )

                            dir "target\\classes"

                            echo.
                            echo ========================================
                            echo Backend JAR
                            echo ========================================

                            dir "target\\*.jar"
                        '''
                    }
                }
            }
        }


        // ============================================================
        // 8. JACOCO COVERAGE
        // ============================================================

        stage('Generate JaCoCo Report') {

            steps {

                echo '========================================'
                echo 'Generating JaCoCo Coverage Report'
                echo '========================================'

                dir("${BACKEND_DIR}") {

                    bat '''
                        echo Generating JaCoCo report...

                        mvn jacoco:report

                        echo.
                        echo Checking JaCoCo output...

                        if exist "target\\site\\jacoco\\jacoco.xml" (

                            echo JaCoCo XML report found.

                            dir "target\\site\\jacoco"

                        ) else (

                            echo WARNING:
                            echo JaCoCo XML report was not generated.

                        )
                    '''
                }
            }
        }


        // ============================================================
        // 9. SONARQUBE ANALYSIS
        // ============================================================

        stage('SonarQube Analysis') {

            steps {

                echo '========================================'
                echo 'Running SonarQube Analysis'
                echo '========================================'

                script {

                    def scannerHome =
                        tool name: "${SONAR_SCANNER}",
                        type: 'hudson.plugins.sonar.SonarRunnerInstallation'

                    withSonarQubeEnv("${SONAR_SERVER}") {

                        bat """
                            echo ========================================
                            echo SonarQube Scanner
                            echo ========================================

                            "${scannerHome}\\\\bin\\\\sonar-scanner.bat" ^
                                -Dsonar.projectKey=${SONAR_PROJECT_KEY} ^
                                -Dsonar.projectName=${APP_NAME} ^
                                -Dsonar.projectVersion=${APP_VERSION} ^
                                -Dsonar.sources=frontend/src,BlogApplication/src ^
                                -Dsonar.java.binaries=BlogApplication/target/classes ^
                                -Dsonar.java.libraries=BlogApplication/target/*.jar ^
                                -Dsonar.javascript.lcov.reportPaths=frontend/coverage/lcov.info ^
                                -Dsonar.coverage.jacoco.xmlReportPaths=BlogApplication/target/site/jacoco/jacoco.xml ^
                                -Dsonar.exclusions=**/node_modules/**,**/dist/**,**/build/**,**/coverage/**,**/lcov-report/**,**/target/**,**/*.test.js,**/*.test.jsx,**/*.spec.js,**/*.spec.jsx,**/src/test/** ^
                                -Dsonar.verbose=false
                        """
                    }
                }
            }
        }


        // ============================================================
        // 10. SONARQUBE QUALITY GATE
        // ============================================================

        stage('SonarQube Quality Gate') {

            steps {

                echo '========================================'
                echo 'Waiting for SonarQube Quality Gate'
                echo '========================================'

                timeout(time: 10, unit: 'MINUTES') {

                    waitForQualityGate(
                        abortPipeline: true
                    )
                }
            }
        }


        // ============================================================
        // 11. DOCKER BUILD - FRONTEND
        // ============================================================

        stage('Docker Build - Frontend') {

            steps {

                echo '========================================'
                echo 'Building Frontend Docker Image'
                echo '========================================'

                bat """
                    docker build ^
                        -t ${FRONTEND_IMAGE}:${APP_VERSION} ^
                        -t ${FRONTEND_IMAGE}:latest ^
                        -f frontend/Dockerfile ^
                        frontend
                """
            }
        }


        // ============================================================
        // 12. DOCKER BUILD - BACKEND
        // ============================================================

        stage('Docker Build - Backend') {

            steps {

                echo '========================================'
                echo 'Building Backend Docker Image'
                echo '========================================'

                bat """
                    docker build ^
                        -t ${BACKEND_IMAGE}:${APP_VERSION} ^
                        -t ${BACKEND_IMAGE}:latest ^
                        -f BlogApplication/Dockerfile ^
                        BlogApplication
                """
            }
        }


        // ============================================================
        // 13. TRIVY FRONTEND SCAN
        // ============================================================

        stage('Trivy Scan - Frontend') {

            steps {

                echo '========================================'
                echo 'Trivy Frontend Image Scan'
                echo '========================================'

                bat """
                    trivy image ^
                        --severity HIGH,CRITICAL ^
                        --ignore-unfixed ^
                        ${FRONTEND_IMAGE}:${APP_VERSION}
                """
            }
        }


        // ============================================================
        // 14. TRIVY BACKEND SCAN
        // ============================================================

        stage('Trivy Scan - Backend') {

            steps {

                echo '========================================'
                echo 'Trivy Backend Image Scan'
                echo '========================================'

                bat """
                    trivy image ^
                        --severity HIGH,CRITICAL ^
                        --ignore-unfixed ^
                        ${BACKEND_IMAGE}:${APP_VERSION}
                """
            }
        }


        // ============================================================
        // 15. DOCKER LOGIN
        // ============================================================

        stage('Docker Login') {

            steps {

                echo '========================================'
                echo 'Logging in to Docker Hub'
                echo '========================================'

                withCredentials([
                    usernamePassword(
                        credentialsId: 'dockerhub-credentials',
                        usernameVariable: 'DOCKER_USERNAME',
                        passwordVariable: 'DOCKER_PASSWORD'
                    )
                ]) {

                    bat '''
                        echo %DOCKER_PASSWORD% | docker login -u %DOCKER_USERNAME% --password-stdin
                    '''
                }
            }
        }


        // ============================================================
        // 16. PUSH FRONTEND IMAGE
        // ============================================================

        stage('Push Frontend Image') {

            steps {

                echo '========================================'
                echo 'Pushing Frontend Image'
                echo '========================================'

                bat """
                    docker push ${FRONTEND_IMAGE}:${APP_VERSION}
                    docker push ${FRONTEND_IMAGE}:latest
                """
            }
        }


        // ============================================================
        // 17. PUSH BACKEND IMAGE
        // ============================================================

        stage('Push Backend Image') {

            steps {

                echo '========================================'
                echo 'Pushing Backend Image'
                echo '========================================'

                bat """
                    docker push ${BACKEND_IMAGE}:${APP_VERSION}
                    docker push ${BACKEND_IMAGE}:latest
                """
            }
        }


        // ============================================================
        // 18. IMAGE SUMMARY
        // ============================================================

        stage('Docker Image Summary') {

            steps {

                echo '========================================'
                echo 'Docker Images'
                echo '========================================'

                bat """
                    docker images ${FRONTEND_IMAGE}
                    docker images ${BACKEND_IMAGE}
                """
            }
        }
    }


    // =================================================================
    // POST ACTIONS
    // =================================================================

    post {

        success {

            echo '''
            ========================================
            PIPELINE SUCCESS
            ========================================
            '''

            echo "Application : ${APP_NAME}"
            echo "Version     : ${APP_VERSION}"

            echo "Frontend    : ${FRONTEND_IMAGE}:${APP_VERSION}"
            echo "Backend     : ${BACKEND_IMAGE}:${APP_VERSION}"

            echo '''
            ========================================
            All pipeline stages completed.
            ========================================
            '''
        }


        failure {

            echo '''
            ========================================
            PIPELINE FAILED
            ========================================
            '''

            echo "Build Number: ${BUILD_NUMBER}"
            echo "Check Jenkins Console Output."
        }


        always {

            echo '========================================'
            echo 'Cleaning Sensitive Files'
            echo '========================================'

            bat '''
                if exist "BlogApplication\\.env" (
                    del /F /Q "BlogApplication\\.env"
                )
            '''

            echo 'Pipeline execution completed.'
        }
    }
}