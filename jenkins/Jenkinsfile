@Library('Shared') _

pipeline {

    // ============================================================
    // AGENT
    // ============================================================

    agent {
        label 'shakthiAgent'
    }

    // ============================================================
    // ENVIRONMENT
    // ============================================================

    environment {

        // --------------------------------------------------------
        // Application
        // --------------------------------------------------------

        APP_NAME = 'sparkNote'

        APP_VERSION = "1.0.${BUILD_NUMBER}"


        // --------------------------------------------------------
        // Docker
        // --------------------------------------------------------

        DOCKER_USERNAME = 'shakthivelk24'

        FRONTEND_IMAGE =
            "${DOCKER_USERNAME}/sparknote-frontend"

        BACKEND_IMAGE =
            "${DOCKER_USERNAME}/sparknote-backend"

        IMAGE_TAG = "${BUILD_NUMBER}"


        // --------------------------------------------------------
        // SonarQube
        // --------------------------------------------------------

        SONAR_PROJECT_KEY = 'sparkNote'


        // --------------------------------------------------------
        // Trivy
        // --------------------------------------------------------

        TRIVY_REPORT_DIR = 'reports/trivy'
    }


    // ============================================================
    // OPTIONS
    // ============================================================

    options {

        timestamps()

        ansiColor('xterm')

        timeout(
            time: 60,
            unit: 'MINUTES'
        )

        buildDiscarder(
            logRotator(
                numToKeepStr: '10'
            )
        )

        disableConcurrentBuilds()
    }


    // ============================================================
    // STAGES
    // ============================================================

    stages {


        // ========================================================
        // STAGE 1
        // CHECK TOOLS
        // ========================================================

        stage('🔧 Check Tools') {

            steps {

                cleanWs()

                customLog(
                    'Checking required tools...'
                )

                check()
            }
        }


        // ========================================================
        // STAGE 2
        // CHECKOUT
        // ========================================================

        stage('🔄 Checkout') {

            steps {

                customLog(
                    'Checking out source code...'
                )

                checkout scm

                script {

                    if (isUnix()) {

                        sh '''
                            echo "========== Last 5 Commits =========="

                            git log --oneline -5

                            echo "========== Git Status =========="

                            git status
                        '''

                    } else {

                        bat '''
                            echo ========== Last 5 Commits ==========

                            git log --oneline -5

                            echo ========== Git Status ==========

                            git status
                        '''
                    }
                }
            }
        }


        // ========================================================
        // STAGE 3
        // INSTALL DEPENDENCIES
        // ========================================================

        stage('📦 Install Dependencies') {

            parallel {


                // ------------------------------------------------
                // FRONTEND DEPENDENCIES
                // ------------------------------------------------

                stage('Frontend Dependencies') {

                    steps {

                        customLog(
                            'Installing frontend dependencies...'
                        )

                        npmInstall(
                            'frontend'
                        )
                    }
                }


                // ------------------------------------------------
                // BACKEND DEPENDENCIES
                // ------------------------------------------------

                stage('Backend Dependencies') {

                    steps {

                        dir('BlogApplication') {

                            customLog(
                                'Installing Spring Boot dependencies...'
                            )

                            script {

                                if (isUnix()) {

                                    sh '''
                                        mvn dependency:go-offline
                                    '''

                                } else {

                                    bat '''
                                        mvn dependency:go-offline
                                    '''
                                }
                            }
                        }
                    }
                }
            }
        }


        // ========================================================
        // STAGE 4
        // RUN TESTS
        // ========================================================

        stage('🧪 Run Tests') {

            parallel {


                // ------------------------------------------------
                // FRONTEND TESTS
                // ------------------------------------------------

                stage('Frontend Tests') {

                    steps {

                        customLog(
                            'Running React tests with coverage...'
                        )

                        npmTest(
                            'frontend',
                            'vitest',
                            'coverage',
                            'junit.xml'
                        )
                    }
                }


                // ------------------------------------------------
                // BACKEND TESTS
                // ------------------------------------------------

                stage('Backend Tests') {

                    steps {

                        dir('BlogApplication') {

                            withCredentials([

                                file(
                                    credentialsId:
                                        'blogapplication-env',

                                    variable:
                                        'ENV_FILE'
                                )

                            ]) {

                                script {

                                    if (isUnix()) {

                                        sh '''
                                            echo "========================================"
                                            echo "Creating Spring Boot .env file"
                                            echo "========================================"

                                            cp "$ENV_FILE" .env

                                            echo "========================================"
                                            echo "Running Maven tests"
                                            echo "========================================"

                                            mvn clean test

                                            echo "========================================"
                                            echo "Generating JaCoCo coverage report"
                                            echo "========================================"

                                            mvn jacoco:report

                                            echo "========================================"
                                            echo "Checking JaCoCo report"
                                            echo "========================================"

                                            ls -la target/site/jacoco/
                                        '''

                                    } else {

                                        bat '''
                                            echo ========================================
                                            echo Creating Spring Boot .env file
                                            echo ========================================

                                            copy /Y "%ENV_FILE%" .env

                                            echo ========================================
                                            echo Running Maven tests
                                            echo ========================================

                                            mvn clean test

                                            echo ========================================
                                            echo Generating JaCoCo coverage report
                                            echo ========================================

                                            mvn jacoco:report

                                            echo ========================================
                                            echo Checking JaCoCo report
                                            echo ========================================

                                            dir target\\site\\jacoco
                                        '''
                                    }
                                }
                            }
                        }
                    }
                }
            }
        }


        // ========================================================
        // STAGE 5
        // STATIC CODE ANALYSIS
        // ========================================================

        stage('🔍 Static Code Analysis') {

            steps {

                customLog(
                    'Running SonarQube analysis...'
                )

                /*
                 * IMPORTANT:
                 *
                 * sonarqubeScan() is a Shared Library step.
                 *
                 * It must NOT contain:
                 *
                 *     stage('SonarQube Scan')
                 *
                 * inside the Shared Library when called here.
                 *
                 * The Declarative stage is already defined here.
                 */

                sonarqubeScan(

                    scannerName:
                        'SonarScanner',

                    sonarServer:
                        'SonarQube',

                    projectKey:
                        SONAR_PROJECT_KEY,

                    projectName:
                        APP_NAME,

                    projectVersion:
                        APP_VERSION,


                    // ------------------------------------------------
                    // SOURCE DIRECTORIES
                    // ------------------------------------------------

                    sources:
                        'frontend/src,BlogApplication/src',


                    // ------------------------------------------------
                    // EXCLUSIONS
                    // ------------------------------------------------

                    exclusions:
                        '''
                        **/node_modules/**,
                        **/dist/**,
                        **/build/**,
                        **/coverage/**,
                        **/lcov-report/**,
                        **/target/**,
                        **/*.test.js,
                        **/*.test.jsx,
                        **/*.spec.js,
                        **/*.spec.jsx,
                        **/src/test/**
                        '''
                        .trim()
                        .replaceAll('\\s+', ''),


                    // ------------------------------------------------
                    // JAVASCRIPT COVERAGE
                    // ------------------------------------------------

                    jsCoverage:
                        'frontend/coverage/lcov.info',


                    // ------------------------------------------------
                    // JAVA COMPILED CLASSES
                    // ------------------------------------------------

                    javaBinaries:
                        'BlogApplication/target/classes',


                    // ------------------------------------------------
                    // JACOCO COVERAGE
                    // ------------------------------------------------

                    javaCoverage:
                        'BlogApplication/target/site/jacoco/jacoco.xml'
                )
            }
        }


        // ========================================================
        // STAGE 6
        // QUALITY GATE
        // ========================================================

        stage('✅ Quality Gate') {

            steps {

                customLog(
                    'Waiting for SonarQube quality gate result...'
                )

                timeout(
                    time: 10,
                    unit: 'MINUTES'
                ) {

                    script {

                        def qualityGateResult =
                            waitForQualityGate()

                        if (
                            qualityGateResult.status != 'OK'
                        ) {

                            error(
                                "SonarQube Quality Gate failed: " +
                                qualityGateResult.status
                            )
                        }

                        customLog(
                            'Quality Gate PASSED ✓'
                        )
                    }
                }
            }
        }


        // ========================================================
        // STAGE 7
        // BUILD APPLICATION
        // ========================================================

        stage('🏗️ Build Application') {

            steps {

                customLog(
                    'Building React frontend...'
                )

                dir('frontend') {

                    script {

                        if (isUnix()) {

                            sh '''
                                npm run build
                            '''

                        } else {

                            bat '''
                                npm run build
                            '''
                        }
                    }
                }
            }
        }


        // ========================================================
        // STAGE 8
        // DOCKER LOGIN
        // ========================================================

        stage('🔑 Docker Login') {

            steps {

                customLog(
                    'Logging in to Docker Hub...'
                )

                withCredentials([

                    usernamePassword(

                        credentialsId:
                            'dockerhub-credentials',

                        usernameVariable:
                            'DOCKER_USER',

                        passwordVariable:
                            'DOCKER_PASS'
                    )

                ]) {

                    script {

                        if (isUnix()) {

                            sh '''
                                echo "$DOCKER_PASS" |
                                docker login \
                                    -u "$DOCKER_USER" \
                                    --password-stdin
                            '''

                        } else {

                            bat '''
                                echo %DOCKER_PASS% |
                                docker login ^
                                    -u %DOCKER_USER% ^
                                    --password-stdin
                            '''
                        }
                    }

                    customLog(
                        'Docker login successful.'
                    )
                }
            }
        }


        // ========================================================
        // STAGE 9
        // BUILD DOCKER IMAGES
        // ========================================================

        stage('🐳 Build Docker Images') {

            parallel {


                // ------------------------------------------------
                // FRONTEND IMAGE
                // ------------------------------------------------

                stage('Build Frontend Image') {

                    steps {

                        customLog(
                            "Building frontend Docker image: " +
                            "${FRONTEND_IMAGE}:${IMAGE_TAG}"
                        )

                        script {

                            if (isUnix()) {

                                sh """
                                    docker build \
                                      -t ${FRONTEND_IMAGE}:${IMAGE_TAG} \
                                      -t ${FRONTEND_IMAGE}:latest \
                                      -f docker/frontend/Dockerfile \
                                      frontend
                                """

                            } else {

                                bat """
                                    docker build ^
                                      -t ${FRONTEND_IMAGE}:${IMAGE_TAG} ^
                                      -t ${FRONTEND_IMAGE}:latest ^
                                      -f docker/frontend/Dockerfile ^
                                      frontend
                                """
                            }
                        }
                    }
                }


                // ------------------------------------------------
                // BACKEND IMAGE
                // ------------------------------------------------

                stage('Build Backend Image') {

                    steps {

                        customLog(
                            "Building backend Docker image: " +
                            "${BACKEND_IMAGE}:${IMAGE_TAG}"
                        )

                        script {

                            if (isUnix()) {

                                sh """
                                    docker build \
                                      -t ${BACKEND_IMAGE}:${IMAGE_TAG} \
                                      -t ${BACKEND_IMAGE}:latest \
                                      -f docker/backend/Dockerfile \
                                      BlogApplication
                                """

                            } else {

                                bat """
                                    docker build ^
                                      -t ${BACKEND_IMAGE}:${IMAGE_TAG} ^
                                      -t ${BACKEND_IMAGE}:latest ^
                                      -f docker/backend/Dockerfile ^
                                      BlogApplication
                                """
                            }
                        }
                    }
                }
            }
        }


        // ========================================================
        // STAGE 10
        // TRIVY IMAGE SCAN
        // ========================================================

        stage('🛡️ Trivy Image Scan') {

            parallel {


                // ------------------------------------------------
                // FRONTEND TRIVY
                // ------------------------------------------------

                stage('Scan Frontend Image') {

                    steps {

                        customLog(
                            'Scanning frontend Docker image with Trivy...'
                        )

                        script {

                            if (isUnix()) {

                                sh """
                                    mkdir -p ${TRIVY_REPORT_DIR}

                                    trivy image \
                                      --severity HIGH,CRITICAL \
                                      --format table \
                                      ${FRONTEND_IMAGE}:${IMAGE_TAG}
                                """

                            } else {

                                bat """
                                    if not exist "${TRIVY_REPORT_DIR}" mkdir "${TRIVY_REPORT_DIR}"

                                    trivy image ^
                                      --severity HIGH,CRITICAL ^
                                      --format table ^
                                      ${FRONTEND_IMAGE}:${IMAGE_TAG}
                                """
                            }
                        }
                    }
                }


                // ------------------------------------------------
                // BACKEND TRIVY
                // ------------------------------------------------

                stage('Scan Backend Image') {

                    steps {

                        customLog(
                            'Scanning backend Docker image with Trivy...'
                        )

                        script {

                            if (isUnix()) {

                                sh """
                                    mkdir -p ${TRIVY_REPORT_DIR}

                                    trivy image \
                                      --severity HIGH,CRITICAL \
                                      --format table \
                                      ${BACKEND_IMAGE}:${IMAGE_TAG}
                                """

                            } else {

                                bat """
                                    if not exist "${TRIVY_REPORT_DIR}" mkdir "${TRIVY_REPORT_DIR}"

                                    trivy image ^
                                      --severity HIGH,CRITICAL ^
                                      --format table ^
                                      ${BACKEND_IMAGE}:${IMAGE_TAG}
                                """
                            }
                        }
                    }
                }
            }
        }


        // ========================================================
        // STAGE 11
        // PUSH DOCKER IMAGES
        // ========================================================

        stage('📤 Push Docker Images') {

            parallel {


                // ------------------------------------------------
                // PUSH FRONTEND
                // ------------------------------------------------

                stage('Push Frontend Image') {

                    steps {

                        customLog(
                            'Pushing frontend Docker image...'
                        )

                        script {

                            if (isUnix()) {

                                sh """
                                    docker push \
                                        ${FRONTEND_IMAGE}:${IMAGE_TAG}

                                    docker push \
                                        ${FRONTEND_IMAGE}:latest
                                """

                            } else {

                                bat """
                                    docker push ^
                                        ${FRONTEND_IMAGE}:${IMAGE_TAG}

                                    docker push ^
                                        ${FRONTEND_IMAGE}:latest
                                """
                            }
                        }
                    }
                }


                // ------------------------------------------------
                // PUSH BACKEND
                // ------------------------------------------------

                stage('Push Backend Image') {

                    steps {

                        customLog(
                            'Pushing backend Docker image...'
                        )

                        script {

                            if (isUnix()) {

                                sh """
                                    docker push \
                                        ${BACKEND_IMAGE}:${IMAGE_TAG}

                                    docker push \
                                        ${BACKEND_IMAGE}:latest
                                """

                            } else {

                                bat """
                                    docker push ^
                                        ${BACKEND_IMAGE}:${IMAGE_TAG}

                                    docker push ^
                                        ${BACKEND_IMAGE}:latest
                                """
                            }
                        }
                    }
                }
            }
        }
    }


    // ============================================================
    // POST ACTIONS
    // ============================================================

    post {

        success {

            customLog(
                '🎉 Pipeline completed successfully!'
            )
        }


        failure {

            customLog(
                '❌ Pipeline failed!'
            )
        }


        always {

            customLog(
                'Pipeline execution completed.'
            )
        }
    }
}