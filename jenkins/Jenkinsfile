@Library('Shared') _

pipeline {

    agent {
        label 'shakthiAgent'
    }

    // ============================================================
    // ENVIRONMENT
    // ============================================================

    environment {

        // Application
        APP_NAME = 'sparkNote'
        APP_VERSION = "1.0.${BUILD_NUMBER}"

        // Docker
        DOCKER_USERNAME = 'shakthivelk24'

        FRONTEND_IMAGE =
            "${DOCKER_USERNAME}/sparknote-frontend"

        BACKEND_IMAGE =
            "${DOCKER_USERNAME}/sparknote-backend"

        IMAGE_TAG = "${BUILD_NUMBER}"

        // SonarQube
        SONAR_PROJECT_KEY = 'sparkNote'

        // Trivy reports
        TRIVY_REPORT_DIR = 'reports/trivy'
    }


    // ============================================================
    // PIPELINE OPTIONS
    // ============================================================

    options {

        timestamps()

        ansiColor('xterm')

        timeout(
            time: 60,
            unit: 'MINUTES'
        )

        buildDiscarder(
            logRotator(
                numToKeepStr: '10'
            )
        )

        disableConcurrentBuilds()
    }


    // ============================================================
    // STAGES
    // ============================================================

    stages {


        // ========================================================
        // STAGE 1: CHECK TOOLS
        // ========================================================

        stage('🔧 Check Tools') {

            steps {

                cleanWs()

                customLog(
                    'Checking required tools...'
                )

                check()
            }
        }


        // ========================================================
        // STAGE 2: CHECKOUT
        // ========================================================

        stage('🔄 Checkout') {

            steps {

                customLog(
                    'Checking out source code...'
                )

                checkout scm

                sh '''
                    echo "========== Last 5 Commits =========="

                    git log --oneline -5

                    echo "========== Git Status =========="

                    git status
                '''
            }
        }


        // ========================================================
        // STAGE 3: INSTALL DEPENDENCIES
        // ========================================================

        stage('📦 Install Dependencies') {

            parallel {

                // ------------------------------------------------
                // FRONTEND
                // ------------------------------------------------

                stage('Frontend Dependencies') {

                    steps {

                        customLog(
                            'Installing frontend dependencies...'
                        )

                        npmInstall('frontend')
                    }
                }


                // ------------------------------------------------
                // BACKEND
                // ------------------------------------------------

                stage('Backend Dependencies') {

                    steps {

                        dir('BlogApplication') {

                            customLog(
                                'Installing Spring Boot dependencies...'
                            )

                            script {

                                if (isUnix()) {

                                    sh 'mvn dependency:go-offline'

                                } else {

                                    bat 'mvn dependency:go-offline'
                                }
                            }
                        }
                    }
                }
            }
        }


        // ========================================================
        // STAGE 4: RUN TESTS
        // ========================================================

        stage('🧪 Run Tests') {

            parallel {

                // ------------------------------------------------
                // FRONTEND TESTS
                // ------------------------------------------------

                stage('Frontend Tests') {

                    steps {

                        customLog(
                            'Running React tests with coverage...'
                        )

                        npmTest(
                            'frontend',
                            'vitest',
                            'coverage',
                            'junit.xml'
                        )
                    }
                }


                // ------------------------------------------------
                // BACKEND TESTS
                // ------------------------------------------------

                stage('Backend Tests') {

                    steps {

                        dir('BlogApplication') {

                            customLog(
                                'Running Spring Boot tests...'
                            )

                            script {

                                if (isUnix()) {

                                    sh 'mvn clean test'

                                } else {

                                    bat 'mvn clean test'
                                }
                            }
                        }
                    }
                }
            }
        }


        // ========================================================
        // STAGE 5: STATIC CODE ANALYSIS
        // ========================================================

        stage('🔍 Static Code Analysis') {

            steps {

                customLog(
                    'Running SonarQube analysis...'
                )

                sonarqubeScan(

                    scannerName:
                        'SonarScanner',

                    sonarServer:
                        'SonarQube',

                    projectKey:
                        SONAR_PROJECT_KEY,

                    projectName:
                        APP_NAME,

                    projectVersion:
                        APP_VERSION,

                    // ------------------------------------------------
                    // SOURCE DIRECTORIES
                    // ------------------------------------------------

                    sources:
                        'frontend/src,BlogApplication/src',

                    // ------------------------------------------------
                    // EXCLUSIONS
                    // ------------------------------------------------

                    exclusions: '''
                        **/node_modules/**,
                        **/dist/**,
                        **/build/**,
                        **/coverage/**,
                        **/lcov-report/**,
                        **/target/**,
                        **/*.test.js,
                        **/*.test.jsx,
                        **/*.spec.js,
                        **/*.spec.jsx
                    '''.trim().replaceAll('\\s+', ''),

                    // ------------------------------------------------
                    // REACT COVERAGE
                    // ------------------------------------------------

                    jsCoverage:
                        'frontend/coverage/lcov.info',

                    // ------------------------------------------------
                    // SPRING BOOT
                    // ------------------------------------------------

                    javaBinaries:
                        'BlogApplication/target/classes',

                    javaCoverage:
                        'BlogApplication/target/site/jacoco/jacoco.xml'
                )
            }
        }


        // ========================================================
        // STAGE 6: QUALITY GATE
        // ========================================================

         stage('✅ Quality Gate') {
            steps {
                customLog('Waiting for SonarQube quality gate result...')
                qualityGate()
            }
        }
    }


    // ============================================================
    // POST ACTIONS
    // ============================================================

    post {

        success {

            customLog(
                '🎉 Pipeline completed successfully!'
            )
        }

        failure {

            customLog(
                '❌ Pipeline failed!'
            )
        }

        always {

            customLog(
                'Pipeline execution completed.'
            )
        }
    }
}